{
  "name": "No Algorithms",
  "manifest_version": 3,
  "version": "1.0.0",
  "description": "Removes algorithmic feeds from websites. No toggles.",
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"],
      "js": [
        "dist/src/feature.js",
        "dist/sites/youtube/homepage/feature.js",
        "dist/sites/youtube/shorts/feature.js",
        "dist/sites/youtube/recommendations/feature.js",
        "dist/sites/instagram/reels/feature.js",
        "dist/sites/instagram/recommendations/feature.js",
        "dist/sites/instagram/search/feature.js",
        "dist/src/main.js"
      ]
    }
  ],
  "web_accessible_resources": [{
    "resources": ["sites/*", "sites/**/*"],
    "matches": ["<all_urls>"]
  }]
}
